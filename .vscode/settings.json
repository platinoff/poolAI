{
  // Terminal settings (Windows)
  // MSYS2 bash profile available for cloud-sdk compilation
  "terminal.integrated.profiles.windows": {
    "bash (MSYS2)": {
      "path": "C:\\msys64\\usr\\bin\\bash.exe",
      "args": ["-l"],
      "env": {
        "MSYSTEM": "UCRT64",
        "CHERE_INVOKING": "1"
      },
      "icon": "terminal-bash"
    }
  },
  // Global PATH for all terminals
  // Priority: Cargo -> MSVC (if available) -> MSYS2 (for GNU toolchain)
  "terminal.integrated.env.windows": {
    "PATH": "C:\\Users\\${env:USERNAME}\\.cargo\\bin;${env:PATH}"
  },
  "terminal.integrated.cwd": "${workspaceFolder}",
  
  // Rust Analyzer settings
  "rust-analyzer.rustc.source": "discover",
  "rust-analyzer.cargo.buildScripts.enable": true
}