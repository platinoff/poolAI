# Temporary build files
Cargo.minimal.toml
Cargo.std.toml

# Temporary files
*.tmp
*.bak
*~
# IDE files (but keep important configs)
.vscode/
.idea/
*.swp
*.swo

# Cursor IDE files
.cursor/
!.cursor/
!.cursor/rules/
!.cursor/rules/*.mdc

# Generated/static audit logs (do not commit/push)
data/audit/*.log.gz

# Scripts (excluded from git)
scripts/

# OS files
.DS_Store
Thumbs.db

# Build artifacts (if not already in .gitignore)
target/
# Alternate CARGO_TARGET_DIR from local test runs (e.g. FM-007)
target-fm007-test/
**/*.pdb
