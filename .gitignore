# Temporary build files
Cargo.minimal.toml
Cargo.std.toml

# Temporary files
*.tmp
*.bak
*~
# IDE files (but keep important configs)
.vscode/
.idea/
*.swp
*.swo

# Cursor IDE files
.cursor/
!.cursor/
!.cursor/rules/
!.cursor/rules/*.mdc

# --- Secrets / credentials (never commit/push) ---
.env
.env.*
*.env
.envrc
.env.local
.env.production
.env.staging
!.env.example
*.pem
*.key
!certs/README.md
secrets/
**/credentials.json
**/service-account*.json

# Local TLS material (generate via certs/README.md or README § certificates)
certs/*.pem
certs/*.key

# Generated/static audit logs (do not commit/push)
data/audit/*
!data/audit/.gitkeep

# GSV durable store (runtime state; do not commit/push)
GSV/data/*
!GSV/data/.gitkeep

# Local one-off git helper scripts (MSYS2 session artifacts; not product)
bin/commit-*.sh
bin/fix-commit-*.sh
bin/do-commit-*.sh
bin/push-*.sh
bin/amend-*.sh
bin/poll-*.sh
bin/_poll-*.sh
bin/git-commit-push.sh
bin/test-vm-create-api.sh

# Corrupted MSYS/Windows path artifacts (literal ":-/" or unicode colon dirs)
:-/
*tmp/poolai-e2e*/
**/poolai-e2e-*/poolai.log
**/poolai-e2e-*/pid
poolai.log
**/poolai.log
**/pid

# Local multi-node LAN dev stand (bin/run-lan-nodes.*)
data/lan-stand/

# Single-node dev launcher (bin/run-poolai.sh single --bg)
data/dev/

# Virtual-node coordinator persistence (FM-016+)
data/virtual_nodes/
data/jobs/
data/memory/
data/monitoring/

# Legacy one-off commit message drafts (do not commit)
docs/development/.commit-msg-*.txt
.commit-msg-*.txt
comitmsg/*
!comitmsg/README.md

# Local marketing assets / social drafts (not product docs)
docs/marketing/

# OS files
.DS_Store
Thumbs.db

# Playwright E2E (S23)
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.cache/

# Build artifacts (if not already in .gitignore)
target/
# Alternate CARGO_TARGET_DIR from local test runs (e.g. FM-007)
target-fm007-test/
**/*.pdb

# PH-S147: wasm-bindgen output (build via bin/build-ui-wasm.sh)
src/ui/wasm/poolai_ui_wasm.js
src/ui/wasm/poolai_ui_wasm_bg.wasm
src/ui/wasm/poolai_ui_wasm_bg.wasm.d.ts
