# Temporary build files
Cargo.minimal.toml
Cargo.std.toml

# Temporary files
*.tmp
*.bak
*~
# IDE files (but keep important configs)
.vscode/
.idea/
*.swp
*.swo

# Cursor IDE files
.cursor/
!.cursor/
!.cursor/rules/
!.cursor/rules/*.mdc

# Generated/static audit logs (do not commit/push)
data/audit/*.log.gz

# Local multi-node LAN dev stand (bin/run-lan-nodes.*)
data/lan-stand/

# Single-node dev launcher (bin/run-poolai.sh single --bg)
data/dev/

# Virtual-node coordinator persistence (FM-016+)
data/virtual_nodes/

# Scripts (excluded from git)
scripts/

# OS files
.DS_Store
Thumbs.db

# Playwright E2E (S23)
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.cache/

# Build artifacts (if not already in .gitignore)
target/
# Alternate CARGO_TARGET_DIR from local test runs (e.g. FM-007)
target-fm007-test/
**/*.pdb
